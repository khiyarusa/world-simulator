{
  "name": "world-simulator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "World Simulator — an offline Android living-world sandbox.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "build:tools": "vite build --config vite.tools.config.ts",
    "golden": "npm run build:tools && node dist-tools/tools.js golden",
    "det": "npm run build:tools && node dist-tools/tools.js determinism",
    "perf": "npm run build:tools && node dist-tools/tools.js bench",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
